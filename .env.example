# Скопируйте этот файл в .env и заполните.

# --- Telegram ---
# Токен бота от @BotFather (команда /newbot)
BOT_TOKEN=
# ЧИСЛОВЫЕ Telegram ID администраторов через запятую, например 123456789,987654321.
# @username не подходит. Свой ID можно узнать командой /id в боте.
# Администраторы получают те же уведомления, что и специалист по выдаче.
ADMIN_IDS=
# Свой Bot API сервер или зеркало, если api.telegram.org недоступен с сервера. Обычно пусто.
TELEGRAM_API_SERVER=
# Прокси для связи с Telegram, если провайдер/сеть блокирует api.telegram.org:443.
# Примеры: socks5://127.0.0.1:10808   socks5://user:pass@host:1080   http://host:3128
# Системный прокси Windows/VPN-клиента Python сам НЕ подхватывает — его нужно указать здесь.
TELEGRAM_PROXY=

# --- Веб-панель ---
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Пароль специалиста по выдаче (заявки, календарь, инвентарь, внутренние брони)
WEB_SPECIALIST_PASSWORD=
# Пароль администратора (всё то же + раздел «Сотрудники» со ссылками-приглашениями)
WEB_ADMIN_PASSWORD=
# Секрет для подписи cookie: любая длинная случайная строка.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEB_SECRET_KEY=

# --- Правила ---
TIMEZONE=Europe/Moscow
MAX_BOOKING_DAYS=14
MAX_ADVANCE_DAYS=90
# Через сколько часов неподтверждённая преподавателем заявка закрывается
PENDING_TTL_HOURS=48
# Студент может подавать заявки только после того, как специалист подтвердит его ФИО и курс.
# Отключать (false) не рекомендуется: курс студент указывает сам.
REQUIRE_STUDENT_VERIFICATION=true
ISSUE_DEFAULT_TIME=14:00
# Места выдачи через «;» — первое подставляется в шаблон по умолчанию
ISSUE_PLACES=ауд. 106.1

# --- База данных ---
# По умолчанию SQLite-файл data/equipment.db. Для PostgreSQL см. docs/ARCHITECTURE.md
# DATABASE_URL=sqlite+aiosqlite:///data/equipment.db
